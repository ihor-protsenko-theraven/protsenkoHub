# Local Postgres from docker compose, or a hosted Postgres URL.
# DIRECT_URL is the direct connection used by Prisma migrations.
# On Neon these two URLs differ: pooled for DATABASE_URL, direct for DIRECT_URL.
DATABASE_URL="postgresql://protsenko:protsenko@localhost:5432/protsenkohub"
DIRECT_URL="postgresql://protsenko:protsenko@localhost:5432/protsenkohub"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001
CORS_ORIGIN="http://localhost:4200"
# Set ALLOW_REGISTRATION=false after the family accounts exist.
ALLOW_REGISTRATION="true"
# Optional first admin created on Vercel install. Leave empty locally.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
HOUSEHOLD_NAME="Родина"
