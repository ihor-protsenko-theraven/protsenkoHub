{
  "name": "protsenkohub-sleep-reminders",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://protsenko-hub-i5bh.onrender.com",
    "REMINDER_MODE": "cron"
  },
  "durable_objects": {
    "bindings": [{ "name": "REMINDER_ALARM", "class_name": "SleepReminderAlarm" }]
  },
  "migrations": [{ "tag": "sleep-reminder-alarm-v1", "new_sqlite_classes": ["SleepReminderAlarm"] }],
  "kv_namespaces": [
    {
      "binding": "REMINDER_SCHEDULE",
      "id": "343860a98ed947deb7109a08dec8ee57"
    }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
