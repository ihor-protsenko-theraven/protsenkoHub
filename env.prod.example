# Скопіюйте в .env.prod на сервері (VPS / Oracle Cloud Always Free) та заповніть секрети.
# Файл .env.prod ігнорується Git і не має потрапляти в репозиторій.

# Домен для автоматичного HTTPS у Caddy (має вказувати A-записом на IP сервера)
APP_DOMAIN=hub.example.com

# Локальний PostgreSQL у docker-compose.prod.yml
POSTGRES_USER=protsenko
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=protsenkohub

# Секрет підпису JWT (згенеруйте: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-long-random-secret

# Заборонити публічну реєстрацію нових родин після створення вашої
ALLOW_REGISTRATION=false

# Опційно: розмір пулу з'єднань БД
DB_POOL_MAX=5

# Опційно: Web Push-нагадування про сон (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=
SLEEP_REMINDER_SCHEDULER_URL=
