<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sleep_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="3dp">
    <TextView
        android:id="@+id/widget_child"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:background="@drawable/sleep_widget_name_background"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:textColor="#433F50"
        android:textSize="10sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/widget_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <Chronometer
                    android:id="@+id/widget_active_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/widget_active_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B5A9FF"
                    android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/widget_idle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/widget_last_ago"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/widget_last_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#D7D3DF"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/widget_last_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#D7D3DF"
                    android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/widget_fallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/widget_fallback_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/widget_fallback_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Відкрити сон ›"
                    android:textColor="#B5A9FF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_active_controls"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_toggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/sleep_widget_outline_button"
                android:contentDescription="Пауза"
                android:padding="8dp"
                android:src="@android:drawable/ic_media_pause"
                android:tint="#B5A9FF" />
            <LinearLayout
                android:id="@+id/widget_actions"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_delete"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/sleep_widget_round_button"
                    android:contentDescription="Видалити сон"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_delete"
                    android:tint="#B5A9FF" />
                <ImageView
                    android:id="@+id/widget_save"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/sleep_widget_round_button"
                    android:contentDescription="Зберегти сон"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_save"
                    android:tint="#B5A9FF" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/widget_start"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/sleep_widget_action_background"
            android:contentDescription="Почати сон"
            android:gravity="center"
            android:text="zZ"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
