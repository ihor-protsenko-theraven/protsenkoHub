<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sleep_widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView
        android:id="@+id/widget_child"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:background="@drawable/sleep_widget_name_background"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#433F50"
        android:textSize="13sp" />
    <LinearLayout
        android:id="@+id/widget_active"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <Chronometer
                android:id="@+id/widget_active_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_active_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#B5A9FF"
                android:textSize="15sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_toggle"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/sleep_widget_outline_button"
            android:contentDescription="Пауза"
            android:padding="18dp"
            android:src="@android:drawable/ic_media_pause"
            android:tint="#B5A9FF" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_delete"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/sleep_widget_round_button"
                android:contentDescription="Видалити сон"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="#B5A9FF" />
            <ImageView
                android:id="@+id/widget_save"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="46dp"
                android:background="@drawable/sleep_widget_round_button"
                android:contentDescription="Зберегти сон"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_save"
                android:tint="#B5A9FF" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_idle"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_last_ago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_last_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#D7D3DF"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_start"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginBottom="9dp"
            android:background="@drawable/sleep_widget_action_background"
            android:contentDescription="Почати сон"
            android:gravity="center"
            android:text="zZ"
            android:textColor="#FFFFFF"
            android:textSize="31sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_fallback"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_fallback_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_fallback_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Відкрити сон ›"
            android:textColor="#B5A9FF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
