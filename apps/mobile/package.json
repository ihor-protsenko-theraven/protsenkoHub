{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "cap sync && node scripts/normalize-ios-spm-paths.mjs",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios && node scripts/normalize-ios-spm-paths.mjs",
    "run:android": "cap run android --no-sync",
