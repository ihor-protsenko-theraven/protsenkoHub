    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.0.0",
    "@capacitor/android": "8.0.0",
    "@capacitor/ios": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0"
  }
}
