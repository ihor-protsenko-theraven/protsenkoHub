{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/*.css", "/*.js", "/manifest.webmanifest", "/icons/logo-mark.png", "/icons/logo-full.webp", "/favicon.ico"]
      }
    },
    {
      "name": "install-icons",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/icons/icon-*.png"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "feeding-dictionary",
      "urls": ["/api/v1/feeding/dictionary"],
      "cacheConfig": {
        "maxSize": 1,
        "maxAge": "1d",
        "strategy": "performance"
      }
    }
  ]
}
