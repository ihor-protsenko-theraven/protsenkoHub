{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/*.css", "/*.js", "/manifest.webmanifest", "/icons/*.png", "/favicon.ico"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "feeding-dictionary",
      "urls": ["/api/v1/feeding/dictionary"],
      "cacheConfig": {
        "maxSize": 1,
        "maxAge": "1d",
        "strategy": "performance"
      }
    }
  ]
}
